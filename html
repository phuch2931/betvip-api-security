<div id="robot-widget" onmousedown="dragStart(event)" ontouchstart="dragStart(event)"
     tabindex="0" role="button" aria-label="Bot dự đoán" aria-pressed="false">
  <div class="robot-inner">
    <div class="robot-platform" id="robot-platform">BETVIP</div>
