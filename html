</div>

<script>
/* ========================================================
   Patched script:
   - Safe DOM updates (no innerHTML from untrusted sources)
   - AbortController for fetches
   - Poll loop that avoids overlapping requests
   - iframe sandbox + referrerpolicy
   - Accessible robot widget (tabindex + keyboard)
   - Prefers-reduced-motion respected in CSS
   ======================================================== */

/* ══ CONFIG ══ */
const APIS = {
  TX: {
    label:   'BETVIP · TX',
    type:    'TX',
    url:     'https://betvip2x.hacksieucap.pro/huddd',
    gameUrl: 'https://play.betvip.trade',
    speak:   'Tài Xỉu BetVip'
  },
  TXMD5: {
    label:   'BETVIP · TX MD5',
    type:    'TX',
    url:     'https://wtxmd52.tele68.com/v1/txmd5/sessions?cp=R&cl=R&pf=web&at=e2f4446802e76a39767a5bab32154970',
    gameUrl: 'https://play.betvip.trade',
    speak:   'Tài Xỉu MD5 BetVip'
  }
};
// Public proxy used originally. Prefer to run your own server-side proxy for reliability and privacy.
const PROXY    = 'https://api.allorigins.win/get?url=';
const MAX_HIST = 20;

/* ══ STATE ══ */
const state = {
  apiKey:       null,
  lastPhien:    '',
  soundEnabled: true,
  history:      [],
  pollTimer:    null,
  pollInterval: 2000,
  fetchController: null,
  fetchFailures: 0,
  running: false
};

/* ══ START / STOP ══ */
function startTool(key) {
  const api = APIS[key];
  if (!api) return;

  state.apiKey    = key;
  state.lastPhien = '';
  state.history   = [];
  state.fetchFailures = 0;

  // Switch screens
  document.getElementById('select-screen').classList.add('hidden');
  document.getElementById('game-screen').classList.remove('hidden');

  // Load game iframe (sandboxed)
  const frame = document.getElementById('game-frame');
  frame.src = api.gameUrl;

  // Show robot + controls
  document.getElementById('robot-platform').textContent = api.label;
  document.getElementById('robot-widget').style.display = 'block';
  document.getElementById('ctrl-panel').style.display   = 'flex';
  // Clear history safely
  document.getElementById('hist-list').textContent = '';
  document.getElementById('history-panel').classList.remove('open');
  document.getElementById('history-panel').setAttribute('aria-hidden', 'true');

  resetResultUI();

  // Start polling loop
  state.running = true;
  schedulePoll(0);

  speak('Kích hoạt robot ' + api.speak);
}

function stopTool() {
  state.running = false;
  if (state.pollTimer) {
    clearTimeout(state.pollTimer);
    state.pollTimer = null;
  }
  if (state.fetchController) {
    try { state.fetchController.abort(); } catch(e) {}
    state.fetchController = null;
  }
}
function goSelect() {
  stopTool();
  document.getElementById('robot-widget').style.display = 'none';
  document.getElementById('ctrl-panel').style.display   = 'none';
  document.getElementById('history-panel').classList.remove('open');
  document.getElementById('history-panel').setAttribute('aria-hidden', 'true');
  const frame = document.getElementById('game-frame');
  frame.src = '';
  document.getElementById('game-screen').classList.add('hidden');
  document.getElementById('select-screen').classList.remove('hidden');
}

/* ══ POLLING SCHEDULE ══ */
function schedulePoll(delay) {
  if (!state.running) return;
  if (state.pollTimer) clearTimeout(state.pollTimer);
  state.pollTimer = setTimeout(async () => {
    await fetchPrediction();
    // adapt interval based on failures (simple backoff)
    const next = Math.min(15000, state.fetchFailures > 0 ? state.pollInterval * (1 + state.fetchFailures) : state.pollInterval);
    schedulePoll(next);
  }, delay);
}

/* ══ FETCH PREDICTION (safe) ══ */
async function fetchPrediction() {
  const api = APIS[state.apiKey];
  if (!api) return;

  // Abort previous controller if any
  if (state.fetchController) {
    try { state.fetchController.abort(); } catch(e) {}
    state.fetchController = null;
  }
  const controller = new AbortController();
  state.fetchController = controller;
  const signal = controller.signal;

  try {
    const url = `${PROXY}${encodeURIComponent(api.url)}&t=${Date.now()}`;
    const res = await fetch(url, { signal, cache: 'no-store' });
    if (!res.ok) throw new Error('Network response not ok: ' + res.status);
    const wrapped = await res.json();

    if (!wrapped || typeof wrapped.contents !== 'string') {
      throw new Error('Unexpected proxy response format');
    }

    let data;
    try {
      data = JSON.parse(wrapped.contents);
    } catch (err) {
      console.warn('Invalid JSON from upstream API', err);
      throw new Error('Invalid JSON from upstream API');
    }

    // success
    state.fetchFailures = 0;
    handleData(data);
  } catch (err) {
    console.warn('fetchPrediction error:', err);
    state.fetchFailures = Math.min(10, state.fetchFailures + 1);
    // show a transient error in UI, but avoid XSS
    const valEl = document.getElementById('result-val');
    if (valEl) valEl.textContent = 'ERR';
  } finally {
    state.fetchController = null;
  }
}
/* ══ HANDLE DATA (safe DOM updates) ══ */
function handleData(data) {
  if (!data || typeof data !== 'object') return;

  // Check if this is MD5 API data (contains multiple Phien entries)
  const api = APIS[state.apiKey];
  const isMD5API = api && api.url.includes('txmd5');
  
  if (isMD5API) {
    handleMD5Data(data);
    return;
  }

  // Handle regular TX API data
  const phien = String(data.Phien_nay || data.phien || data.session || data.id || '');
  const raw   = String(data.Dudoan || data.dudoan || data.predict || data.result || '');
  const conf  = String(data.Dotincay || data.dotincay || data.confidence || data.rate || '');

  if (!raw) return;

  // Update phien & confidence safely
  const phienEl = document.getElementById('phien-label');
  phienEl.classList.remove('loading');
  phienEl.textContent = 'Phiên: ' + (phien || '--');
  if (!phien) phienEl.classList.add('loading');

  const confEl = document.getElementById('result-conf');
  // Clear and append safe nodes
  confEl.textContent = 'Tin cậy: ';
  const span = document.createElement('span');
  span.textContent = conf || '--';
  confEl.appendChild(span);

  // Skip render if same phien to avoid duplicates
  if (phien && phien === state.lastPhien) return;
  state.lastPhien = phien;

  const led = document.getElementById('led');
  const box = document.getElementById('result-box');
  const val = document.getElementById('result-val');
  const sub = document.getElementById('result-sub');

  // Reset classes and text safely
  val.classList.remove('loading-anim');
  box.className = 'result-box';
  val.className = 'result-val';
  sub.className = 'result-sub';
  sub.textContent = '';
  led.classList.add('on');

  const upper = raw.toUpperCase();
  const isTai = upper.includes('TAI') || upper.includes('TÀI') || upper === 'T' || upper.startsWith('T ');
  const isXiu = upper.includes('XIU') || upper.includes('XỈU') || upper === 'X' || upper.startsWith('X ');

  if (isTai) {
    box.classList.add('tai');
    val.classList.add('tai');
    val.textContent = 'TÀI';
    sub.classList.add('tai');
    sub.textContent = '▲ OVER';
    speak('Tài');
    addHistory(phien, 'TÀI', conf, 'tai');
  } else if (isXiu) {
    box.classList.add('xiu');
    val.classList.add('xiu');
    val.textContent = 'XỈU';
    sub.classList.add('xiu');
    sub.textContent = '▼ UNDER';
    speak('Xỉu');
    addHistory(phien, 'XỈU', conf, 'xiu');
  } else {
    box.classList.add('special');
    val.classList.add('special');
    // limit content length and set as text to avoid injection
    val.textContent = raw.substring(0, 100);
    speak(raw);
    addHistory(phien, raw, conf, 'special');
  }
}

/* ══ HANDLE MD5 DATA ══ */
function handleMD5Data(data) {
  try {
    // Parse the raw string data - it contains multiple "Phien" entries
    let rawText = '';
    if (typeof data === 'string') {
      rawText = data;
    } else if (data.data || data.content || data.response) {
      rawText = data.data || data.content || data.response;
    } else {
      rawText = JSON.stringify(data);
    }

    console.log('MD5 API data:', rawText);

    // Extract all Phien entries using regex
    const phienPattern = /"Phien":(\d+):\s*([a-f0-9]{32})\s*(\d+)\s*(tai|xiu)/gi;
    const matches = [...rawText.matchAll(phienPattern)];
    
    if (!matches.length) {
      console.warn('No valid Phien entries found in MD5 API response');
      return;
    }

    // Get the latest entry (last in the list)
    const latestMatch = matches[matches.length - 1];
    const phien = latestMatch[1];
    const hash = latestMatch[2];
    const diceSum = parseInt(latestMatch[3]);
    const result = latestMatch[4].toLowerCase();

    // Skip if same phien
    if (phien && phien === state.lastPhien) {
      return;
    }

    // Calculate confidence based on dice sum patterns
    let confidence = 65; // base confidence
    if (diceSum <= 6 || diceSum >= 15) confidence = 85; // extreme values
    else if (diceSum <= 8 || diceSum >= 13) confidence = 75; // strong values
    else confidence = 70; // moderate values

    // Update phien display
    const phienEl = document.getElementById('phien-label');
    phienEl.classList.remove('loading');
    phienEl.textContent = 'Phiên: ' + phien;

    // Update confidence display
    const confEl = document.getElementById('result-conf');
    confEl.textContent = 'Tin cậy: ';
    const span = document.createElement('span');
    span.textContent = confidence + '%';
    confEl.appendChild(span);

    state.lastPhien = phien;

    const led = document.getElementById('led');
    const box = document.getElementById('result-box');
    const val = document.getElementById('result-val');
    const sub = document.getElementById('result-sub');

    // Reset classes and text safely
    val.classList.remove('loading-anim');
    box.className = 'result-box';
    val.className = 'result-val';
    sub.className = 'result-sub';
    sub.textContent = '';
    led.classList.add('on');

    const isTai = result === 'tai';
    const isXiu = result === 'xiu';

    if (isTai) {
      box.classList.add('tai');
      val.classList.add('tai');
      val.textContent = 'TÀI';
      sub.classList.add('tai');
      sub.textContent = `▲ OVER (${diceSum})`;
      speak('Tài');
      addHistory(phien, 'TÀI', confidence + '%', 'tai', hash);
    } else if (isXiu) {
      box.classList.add('xiu');
      val.classList.add('xiu');
      val.textContent = 'XỈU';
      sub.classList.add('xiu');
      sub.textContent = `▼ UNDER (${diceSum})`;
      speak('Xỉu');
      addHistory(phien, 'XỈU', confidence + '%', 'xiu', hash);
    }

    console.log('Processed MD5 prediction:', {
      phien,
      result: result.toUpperCase(),
      diceSum,
      hash: hash.substring(0, 16) + '...',
      confidence
    });

  } catch (error) {
    console.error('Error processing MD5 API response:', error);
  }
}
/* ══ HISTORY (safe rendering) ══ */
function addHistory(phien, pred, conf, cls, hash) {
  state.history.unshift({
    phien: String(phien || ''),
    pred: String(pred || ''),
    conf: String(conf || ''),
    cls: String(cls || ''),
    hash: String(hash || ''),
    time: new Date().toLocaleTimeString('vi-VN')
  });
  if (state.history.length > MAX_HIST) state.history.pop();
  renderHistory();
}

function renderHistory() {
  const list = document.getElementById('hist-list');
  list.textContent = '';
  state.history.forEach(h => {
    const d = document.createElement('div');
    d.className = 'hist-item ' + h.cls;

    const strong = document.createElement('strong');
    strong.textContent = '#' + h.phien;

    const text = document.createTextNode(' — ' + h.pred);
    const br = document.createElement('br');

    const small = document.createElement('small');
    small.textContent = `${h.time} · ${h.conf}`;

    d.appendChild(strong);
    d.appendChild(text);
    d.appendChild(br);
    
    // Add hash info if available (for MD5 predictions)
    if (h.hash) {
      const hashDiv = document.createElement('div');
      hashDiv.style.fontSize = '8px';
      hashDiv.style.color = '#666';
      hashDiv.style.fontFamily = 'monospace';
      hashDiv.textContent = '🔐 ' + h.hash.substring(0, 16) + '...';
      d.appendChild(hashDiv);
    }
    
    d.appendChild(small);

    list.appendChild(d);
  });
}

/* ══ UI HELPERS ══ */
function resetResultUI() {
  const val = document.getElementById('result-val');
  if (val) {
    val.textContent  = 'SCAN';
    val.className  = 'result-val loading-anim';
  }
  const box = document.getElementById('result-box');
  if (box) box.className  = 'result-box';
  const sub = document.getElementById('result-sub');
  if (sub) { sub.textContent  = ''; sub.className  = 'result-sub'; }
  const led = document.getElementById('led');
  if (led) led.className = 'led';
  const phien = document.getElementById('phien-label');
  if (phien) { phien.textContent = 'Phiên: --'; phien.classList.add('loading'); }
  const conf = document.getElementById('result-conf');
  if (conf) {
    conf.textContent = 'Tin cậy: ';
    const s = document.createElement('span'); s.textContent = '--'; conf.appendChild(s);
  }
}
/* ══ HISTORY / SOUND CONTROLS ══ */
function toggleHistory() {
  const panel = document.getElementById('history-panel');
  const btn = document.getElementById('hist-btn');
  const isOpen = panel.classList.toggle('open');
  panel.setAttribute('aria-hidden', String(!isOpen));
  btn.setAttribute('aria-pressed', String(isOpen));
}

function toggleSound() {
  state.soundEnabled = !state.soundEnabled;
  const btn = document.getElementById('sound-btn');
  btn.style.opacity = state.soundEnabled ? '1' : '0.4';
  if (state.soundEnabled) speak('Âm thanh bật');
}

/* ══ SPEECH (throttled and feature-checked) ══ */
function speak(text) {
  if (!state.soundEnabled || !text) return;
  if (!('speechSynthesis' in window) || !('SpeechSynthesisUtterance' in window)) return;
  try {
    window.speechSynthesis.cancel(); // cancel previous to avoid queue build-up
    const u = new SpeechSynthesisUtterance(text);
    u.lang = 'vi-VN';
    u.rate = 1.05;
    window.speechSynthesis.speak(u);
  } catch (e) {
    console.warn('Speech synthesis failed', e);
  }
}

/* ══ DRAG (mouse/touch) ══ */
const widget = document.getElementById('robot-widget');
let _ox = 0, _oy = 0, _drag = false;

function dragStart(e) {
  _drag = true;
  const ev = e.touches ? e.touches[0] : e;
  _ox = ev.clientX - widget.offsetLeft;
  _oy = ev.clientY - widget.offsetTop;
  // for touch, prevent default to avoid scrolling while dragging
  if (e.touches) e.preventDefault();
}

document.addEventListener('mousemove', dragMove);
document.addEventListener('touchmove', dragMove, { passive: false });
document.addEventListener('mouseup',   () => { _drag = false; });
document.addEventListener('touchend',  () => { _drag = false; });

function dragMove(e) {
  if (!_drag) return;
  e.preventDefault();
  const ev = e.touches ? e.touches[0] : e;
  const x = Math.max(0, Math.min(ev.clientX - _ox, window.innerWidth  - widget.offsetWidth));
  const y = Math.max(0, Math.min(ev.clientY - _oy, window.innerHeight - widget.offsetHeight));
  widget.style.left = x + 'px';
  widget.style.top  = y + 'px';
}
/* Keyboard support for widget: Enter toggles history */
widget.addEventListener('keydown', (ev) => {
  if (ev.key === 'Enter' || ev.key === ' ') {
    ev.preventDefault();
    toggleHistory();
  } else if (ev.key === 'Escape') {
    // move focus away and hide history
    document.activeElement.blur();
    document.getElementById('history-panel').classList.remove('open');
    document.getElementById('history-panel').setAttribute('aria-hidden', 'true');
  }
});

/* Make sure controls are keyboard friendly */
document.getElementById('hist-btn').addEventListener('keydown', (ev) => {
  if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); toggleHistory(); }
});

/* Accessibility: expose a cleanup when page is hidden */
document.addEventListener('visibilitychange', () => {
  if (document.hidden) {
    // stop polling to save resources
    stopTool();
  }
});
